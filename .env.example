# ==============================================================================
# DocuChat - Multi-Document RAG Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Groq LLM API Configuration
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
MAX_TOKENS=1500

# Embedding Configuration
# "local" runs the zero-dependency sublinear BM25+TF-IDF dense vector engine
# "sentence_transformers" loads BAAI/bge-small-en-v1.5 or all-MiniLM-L6-v2 via PyTorch
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Document Ingestion & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25

# Retrieval & Guardrails
TOP_K=4
RELEVANCE_THRESHOLD=0.25
